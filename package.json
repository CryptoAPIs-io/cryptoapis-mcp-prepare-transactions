  "description": "MCP server for building unsigned transactions on EVM, Tezos, Solana, Kaspa, XRP, UTXO, and Tron via Crypto APIs",
  "license": "MIT",
  "author": "Crypto APIs, Inc.",
  "repository": {
    "type": "git",
